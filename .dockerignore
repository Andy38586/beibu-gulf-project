# 密钥与运行时环境不进镜像（改为 compose 运行时注入，详见 docker-compose.yml）
# 仅排除真实密钥文件，保留 backend/.env.example 作为镜像内参考模板
backend/.env
backend/.env.*
!backend/.env.example

# 运行时数据（用户库/方案库/端口/POI，含 PII）不进镜像
# 改为 compose 运行时 volume 挂载 ./backend/data:/app/backend/data，详见 docker-compose.yml
backend/data/

# DEM 静态产物（dem_hillshade.tif 67MB + png 5.8MB）不进镜像：
# tif 被 .gitignore 排除（CI checkout 不存在），本地构建却会带上 → CI 与本地镜像内容不一致，
# 且 73MB 冗余。改为 compose volume 挂载 ./backend/static/dem:/app/backend/static/dem。
# 待接入数据库/对象存储后整体替换此方案。
backend/static/dem/

# TLS 证书通过 compose volume 挂载，不烘焙进镜像
certs/
