# 仓库根环境变量示例（复制为 .env 后按需填写；真实密钥不入库，见 backend/.env.example 与 CI Secrets）
# 前端（frontend/.env.local 或本文件——Vite 以 cwd=frontend 运行，读取 frontend/.env*）

# 数据源模式：api（Express JSON）/ online（FastAPI 真演算）/ mock（契约桩）
VITE_DATA_SOURCE=api
# API 基址（默认 /api 由 dev proxy 转发）
# VITE_API_BASE=/api
# 天地图 key（申请：https://console.tianditu.gov.cn/）
# VITE_TIANDITU_KEY=

# 后端
# PORT=3000
# LOG_DIR=./logs
# NODE_ENV=development

# FastAPI 洪涝演算服务
# FLOOD_SERVICE_PORT=8000
