# 前端 lint + format（仅检查暂存文件）
# husky v9：直接写命令，不需要 source _/husky.sh
# 注意：git 执行 hook 时 cwd 默认即为仓库根，故此处不 `cd frontend`。

# 🔴 任一步失败即终止（此前无此行）：实测把语法错文件暂存后，`npx lint-staged`
# 打印 `prettier --write [FAILED]` 并退出 1，而脚本继续跑完三步快集门禁、最终 rc=0
# ⇒ 提交照过，失败被吞。下面三步虽各自写了 `|| exit 1`，lint-staged 那条没有。
# `if`/`$(...)` 内的非零返回不受 set -e 影响，受保护文档的判定逻辑不变。
set -e
# lint-staged 配置在根 package.json 的 "lint-staged" 字段（原 .lintstagedrc.json 已 2026-08-11 合并），
# glob 为 `frontend/src/**/*.{ts,vue,js,css}`（git 根相对路径），
# 从仓库根运行 lint-staged 才能正确匹配暂存的前端文件。

# ===== 受保护文档防删除守卫（husky pre-commit）=====
# 作用：把以下文档「提交删除/重命名」时直接拦截，防止误删固化进历史。
# 局限：本守卫不能阻止日常 rm（本地删除），只能阻止“提交删除”。
# 真正的防丢靠远程仓库（git push）——本地 rm 碰不到远程副本。
# 如需故意删除某文档：编辑下方 PROTECTED 列表移除它，或 git commit --no-verify。
# 2026-08-12：docs 台账/审计文档整体移出版本库（学习性质不公开），受保护三文档随 docs/* 忽略规则
# 一并移出，守卫列表清空（根基文档 docs/根基文档/ 为唯一保留公开区，若需保护可在此追加）
PROTECTED=""

_changed=$(git -c core.quotepath=false diff --cached --name-status | awk '$1 ~ /^[DR]/ {print $2}')
_bad=""
# 2026-08-10（面试报告 P1-3）：修复变量名 bug——循环读 $PROTECTED（原写 $_PROTECTED
# 恒为空，守卫从未生效，受保护文档删除不会被拦截）
for _p in $PROTECTED; do
  if echo "$_changed" | grep -qx "$_p"; then
    _bad="$_bad$_p
"
  fi
done
if [ -n "$_bad" ]; then
  echo "pre-commit 拦截：以下受保护文档正被删除/重命名，已阻止提交："
  printf '%s' "$_bad"
  echo "------------------------------------------------------------"
  echo "如需故意删除：编辑 .husky/pre-commit 的 PROTECTED 列表，或 git commit --no-verify"
  exit 1
fi
# ===== 守卫结束 =====

npx lint-staged

# ===== 快集门禁（z055 挂载点）=====
# 背景：全量 13+ 项门禁原只挂 pre-push，而本批 38 个提交一次都没 push 过 ⇒ 一次都没跑；
# CI 又只在 push 时触发 ⇒ 合入质量失去机器判据。且"每修一项即提交"与"push 才跑重门禁"
# 天然抵触——谁都不想 commit 被全量门禁卡住，于是一条都不跑。
# 解法：快集（秒级、只读既有产物/静态检查）前移到 commit 时；全量套件仍留 pre-push。
# 快集清单：guard:v3（21 项静态守卫，含 ledger-dedupe/cruise-coverage/nest-controllers-data）
#          + cruise（架构契约）+ types:check（契约快照新鲜度 + schema 覆盖）+ 格式（本次暂存文件）。
# 改动这三个文件同宗的判据时，本 hook 当场红；跑全量请 push（pre-push 13 项）。
echo "[pre-commit] 快集门禁 1/4 guard:v3"
npm run guard:v3 || exit 1
echo "[pre-commit] 快集门禁 2/4 架构契约（cruise）"
npm run cruise || exit 1
echo "[pre-commit] 快集门禁 3/4 API 契约（types:check）"
npm run types:check || exit 1
# 全仓格式：上面的 lint-staged 只处理**本次暂存**的文件，生成物与未暂存改动会漏 ——
# 实测「改完十几个文件却没跑 format:check」，红在 dead-code-baseline.json 上。
# 但把兜底做成**全仓**扫描，就在同树多会话下变成互锁：任一会话留下一个未排版文件
# （2026-09-26 实测：另一会话在飞的 forecast.service.ts 未 prettier）会把别人的 commit
# 一起锁死，而被锁的人改不动也绕不得。责任归属应到「谁改谁排版」，不是「谁撞上了谁背」。
# 故：默认只校本次暂存文件；全仓口径保留在 FORMAT_FULL=1 git commit 与 npm run ci:local。
echo "[pre-commit] 快集门禁 4/4 格式（本次暂存文件；全仓用 FORMAT_FULL=1）"
if [ "${FORMAT_FULL:-0}" = "1" ]; then
  npm run format:check || exit 1
else
  git diff --cached --name-only --diff-filter=ACMR -z \
    | grep -zE '\.(ts|tsx|js|jsx|mjs|cjs|vue|css|scss|json|md|yml|yaml|html)$' \
    | xargs -0 -r npx prettier --check || exit 1
fi
echo "[pre-commit] 快集门禁全部通过"
