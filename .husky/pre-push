#!/usr/bin/env sh
# pre-push：门禁 = 全量 typecheck（前端 vue-tsc + 后端 nest tsc） + v3 三道防线 + nest 全量测试。
# 背景：pre-commit 仅跑 lint（eslint/ban-ts-comment 拦 @ts-nocheck），
# 但类型错误（如 store 属性不存在、签名不匹配）eslint 不报——
# 必须在 push 前跑全量 vue-tsc，typecheck 不过拒绝推送。
# 后端 nest：nest build 对类型错误 exit 0，tsc --noEmit 才是真实类型门禁；
# 无 PG 环境（本机/CI）真库 e2e 套件经 V3_INTEGRATION_DB 门控自动跳过，不阻塞推送。
# 全量 typecheck 约 1-2 分钟，故放 push 而非 commit；本地可随时手动 npm run typecheck。
npm run typecheck
npm run typecheck --prefix backend/nest
npm run guard:v3
npm test --prefix backend/nest
