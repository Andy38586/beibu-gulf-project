# 官方源（2026-09-11）：锁文件 resolved 必须指向 registry.npmjs.org，否则服务器/CI 的
# npm ci 会因 npmmirror 生成的不完整 lock（缺 optional 条目）报 EUSAGE——主 Dockerfile
# 被迫退回 npm install（不可复现构建）的根因即此。此前 registry 取自全局 ~/.npmrc
#（npmmirror），每次本地 install 都会把 lock 重写回 mirror、冲掉官方源重建成果。
# ⚠️ 全局 npmmirror 用户在本项目内 install 会走官方源（直连不稳时可临时
# `npm install --registry=https://registry.npmmirror.com`，但事后须检查 lock 是否被改写）。
registry=https://registry.npmjs.org/

engine-strict=true

# legacy-peer-deps（2026-09-16 核实）：真实用途是 rollup-peer 链插件——vite 8 以 rolldown
# 取代 rollup 后，rollup-plugin-visualizer / rollup-plugin-external-globals / unplugin 声明的
# `rollup` peer 在依赖树中不存在，默认严格校验下 npm ci 报 EUSAGE（2026-09-12 z159 实证：
# 镜像漏 COPY 本文件即构建失败）。历史另曾用于规避 eslint-plugin-import 的 peer 滞后，
# 但该插件最终未采用（改用 eslint-plugin-simple-import-sort，见 eslint.config.js 头注），
# 从未进入依赖树。移除本项前须先验证干净环境 npm ci 通过。
legacy-peer-deps=true
