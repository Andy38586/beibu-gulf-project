# Nest 运行配置样例：复制为 .env 后按环境填写（.env 已 gitignore，禁止提交真实凭据）

# 运行环境：development（默认）| production（生产关闭 /nest-api/docs 暴露面）
NODE_ENV=development

# 监听端口（迁移期默认 3100 避让老 Express 的 3000；Express 退役后回切 3000）
PORT=3100

# JWT 签名密钥（必填，至少 32 字符；生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
JWT_SECRET=

# PostGIS 连接（开发默认值对齐 docker-compose.v3.yml；生产凭据必须环境注入，默认口令禁止外溢）
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=v3_dev

# 数据目录（可选：默认从 cwd 向上查找 backend/data；容器/异构部署时显式指定）
# DATA_DIR=/data/beibu
