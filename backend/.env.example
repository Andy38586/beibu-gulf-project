# Nest 运行配置样例：复制为 .env 后按环境填写（.env 已 gitignore，禁止提交真实凭据）

# 运行环境：development（默认）| production（生产关闭 /nest-api/docs 暴露面）
NODE_ENV=development

# 监听端口（Express 已退役，统一 3000；与 docker-compose.yml / vite proxy 一致）
PORT=3000

# JWT 签名密钥（必填，至少 32 字符；生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
JWT_SECRET=

# PostGIS 连接（开发默认值对齐 docker-compose.v3.yml；生产凭据必须环境注入，默认口令禁止外溢）
# ⚠️ P0（EP-09 / EH-07）：NODE_ENV=production 时 PG_PASSWORD 必填且不得为 `postgres`，
#    缺失即启动失败（db.config 强校验 + compose `${POSTGRES_PASSWORD:?}` 双重拦截）。
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=beibu-gulf-data

# 数据目录（可选：默认从 cwd 向上查找 backend/data；容器/异构部署时显式指定）
# DATA_DIR=/data/beibu
