# ============================================================================
# 北部湾智慧港口大屏 - 前端环境变量模板
# ⚠️ 复制本文件为 .env（本地开发）或 .env.production（生产）并填写实际值。
#    不要把真实密钥提交到 Git。
#
# Vite 变量加载规则：
#   1. 只有 VITE_ 开头的变量才会被注入到前端代码；
#   2. .env 在 `npm run dev` 时加载，.env.production 在 `npm run build` 时加载；
#   3. .env.local / .env.production.local 优先级更高且默认被 .gitignore。
# ============================================================================

# ----------------------------------------------------------------------------
# 1. 后端 API 基础路径
#    - 同域部署（Vite dev proxy / Nginx 反代 /api）：填 '/api'（默认）
#    - 跨域部署（独立后端域名）：填 'https://api.example.com/beibu'
# ----------------------------------------------------------------------------
VITE_API_BASE=/api

# ----------------------------------------------------------------------------
# 2. ⚠️ VITE_DATA_SOURCE 已废弃（z156，2026-09-12 清理）：数据源切换代码已随
#    algorithm-service 退役删除，配置此变量无效——勿再引入。
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# v3/v4 逐模块切换 —— **已退役（D1a 收口，2026-10-12）**
#    原先 VITE_USE_NEST_MODULES 是逗号分隔功能域清单，按批填入即切 Nest，留空走 /api 旧前缀
#    （当时当作"回滚开关"）。Express 退役后那一侧不再有独立实现，且两个环境归宿并不一致：
#      · dev 的 Vite proxy 对 /api **无 rewrite** ⇒ 落到 /api 即 404（开关在 dev 是承重的）
#      · 生产的 nginx 对 /api **有** rewrite → /nest-api ⇒ 与单前缀同一服务
#    即该开关只改 URL 前缀、不改后端实现。故收口为单前缀，清单与开关一并删除。
#    历史事故（本变量的不变量是"清单必须与后端域集逐一对齐"，三次踩）：route 域漏配、
#    v4 加 task 域时漏配、2026-10-01 漏 site-suitability/diversion 致 dev 两页面 404。
#
#    VITE_NEST_API_BASE：现在是**唯一**的后端基址，默认 /nest-api（Vite proxy 与 nginx 反代须同口径）
# ----------------------------------------------------------------------------
# VITE_NEST_API_BASE=/nest-api

# ----------------------------------------------------------------------------
# 3. 天地图开发者密钥（必填，否则底图全白）
#    申请地址：https://console.tianditu.gov.cn/api/key
#    注意：生产环境请绑定域名白名单，防止 key 被盗刷。
# ----------------------------------------------------------------------------
VITE_TIANDITU_KEY=your_tianditu_key_here

# ----------------------------------------------------------------------------
# 4. Cesium 静态资源基础路径（可选）
#    - 默认由 vite-plugin-cesium 注入到 /cesium
#    - 仅当部署到非根路径或自定义 Cesium 资源位置时才需要调整
# ----------------------------------------------------------------------------
# VITE_CESIUM_BASE_PATH=/cesium
