# ============================================================================
# 北部湾智慧港口大屏 - 前端环境变量模板
# ⚠️ 复制本文件为 .env（本地开发）或 .env.production（生产）并填写实际值。
#    不要把真实密钥提交到 Git。
#
# Vite 变量加载规则：
#   1. 只有 VITE_ 开头的变量才会被注入到前端代码；
#   2. .env 在 `npm run dev` 时加载，.env.production 在 `npm run build` 时加载；
#   3. .env.local / .env.production.local 优先级更高且默认被 .gitignore。
# ============================================================================

# ----------------------------------------------------------------------------
# 1. 后端 API 基础路径
#    - 同域部署（Vite dev proxy / Nginx 反代 /api）：填 '/api'（默认）
#    - 跨域部署（独立后端域名）：填 'https://api.example.com/beibu'
# ----------------------------------------------------------------------------
VITE_API_BASE=/api

# ----------------------------------------------------------------------------
# 2. 数据源模式（可选，默认 api）
#    可选值：mock（前端静态 fixture，无需后端）/ api（走后端接口，生产推荐）/ online（FastAPI 实时演算，仅洪水）
#    默认 api：未配置即走真实后端（生产安全）；本地离线开发务必显式设 VITE_DATA_SOURCE=mock（建议写入 .env.local）。
# ----------------------------------------------------------------------------
VITE_DATA_SOURCE=api

# ----------------------------------------------------------------------------
# 3. 天地图开发者密钥（必填，否则底图全白）
#    申请地址：https://console.tianditu.gov.cn/api/key
#    注意：生产环境请绑定域名白名单，防止 key 被盗刷。
# ----------------------------------------------------------------------------
VITE_TIANDITU_KEY=your_tianditu_key_here

# ----------------------------------------------------------------------------
# 4. Cesium 静态资源基础路径（可选）
#    - 默认由 vite-plugin-cesium 注入到 /cesium
#    - 仅当部署到非根路径或自定义 Cesium 资源位置时才需要调整
# ----------------------------------------------------------------------------
# VITE_CESIUM_BASE_PATH=/cesium
