{
  "name": "beibu-gulf-webgis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd frontend && vite",
    "build": "npm run typecheck && cd frontend && vite build",
    "preview": "cd frontend && vite preview",
    "test": "cd frontend && vitest run",
    "test:watch": "cd frontend && vitest",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "stylelint": "stylelint \"frontend/src/**/*.{css,vue}\"",
    "stylelint:fix": "stylelint \"frontend/src/**/*.{css,vue}\" --fix",
    "typecheck": "vue-tsc --noEmit -p frontend/tsconfig.app.json",
    "types:gen": "node scripts/gen-api-contract.cjs",
    "types:check": "node scripts/gen-api-contract.cjs --check",
    "changelog": "node tools/gen-changelog.cjs && prettier --write CHANGELOG.md",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard:v3": "node tools/v3-guard/no-ephemeral.mjs && node tools/v3-guard/structure-check.mjs && node tools/v3-guard/routes-audit.mjs",
    "ci:local": "npm run guard:v3 && npm run format:check && npm run lint && npm run stylelint && npm run cruise && npm run typecheck && npm run typecheck --prefix backend/nest && npm test -- --coverage && npm test --prefix backend -- --coverage && npm test --prefix backend/nest -- --coverage && npm run build",
    "build:analyze": "cd frontend && vite build --mode analyze",
    "cruise": "dependency-cruiser -c .dependency-cruiser.cjs -T err frontend/src backend",
    "dev:express": "npm --prefix backend run dev",
    "dev:nest": "npm --prefix backend/nest run start:dev",
    "dev:flood": "node tools/run-flood.cjs",
    "dev:server": "run-p dev:express dev:flood",
    "dev:all": "run-p dev dev:server",
    "forecast:model": "node tools/throughput_model.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "cesium": "^1.142.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.2",
    "ol": "^10.9.0",
    "pdf-parse": "^2.4.5",
    "pinia": "^3.0.4",
    "rbush": "^4.0.1",
    "resize-observer-polyfill": "^1.5.1",
    "vite-plugin-cesium": "^1.2.23",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/rbush": "^4.0.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "~10.9.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.10",
    "npm-run-all2": "^9.0.2",
    "postcss-html": "^1.7.0",
    "prettier": "3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "dompurify": "^3.4.13",
    "glob": "^10.5.0",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23",
    "protobufjs": "^8.7.1",
    "shell-quote": "^1.8.5",
    "undici": "^7.29.0"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,vue,js,css}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always",
    "endOfLine": "lf",
    "vueIndentScriptAndStyle": false
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11",
    "Chrome >= 89",
    "Safari >= 14.1",
    "Firefox >= 114"
  ]
}
